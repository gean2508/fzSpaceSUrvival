# Copy to .env to enable Postgres persistence. If unset, the server runs with
# an in-memory profile store (progress is not durable) so LAN/offline dev works
# without Docker.
DATABASE_URL=postgres://hunger:hunger@localhost:5432/hunger_arena

# Network
PORT=2567
HOST=0.0.0.0

# Auth — REQUIRED in production (>=16 chars). Generate, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me

# Production hardening. When NODE_ENV=production:
#  - dev tools (/colyseus, /playground) are disabled
#  - JWT_SECRET must be set to a strong value
#  - CORS only allows the comma-separated origins below
NODE_ENV=development
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
