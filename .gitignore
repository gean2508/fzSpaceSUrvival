node_modules/
dist/
packages/*/dist/
client/dist/
server/dist/
.env
.env.local
*.log
.DS_Store
.turbo/

# Build del cliente nativo (Rust + Android). `native/target/` llega a 20 GB:
# si el disco se llena, `rm -rf native/target/debug` (el build de Android usa
# otro target dir). Ver biblia.md §12.
native/target/
native/android/.gradle/
native/android/app/build/
native/android/app/src/main/jniLibs/
hunger-arena.apk

# Grafo de código (regenerable con `graphify update .`).
graphify-out/
native/graphify-out/

# Packs LimeZu crudos — material de referencia, ~1 GB. No se bundlean ni se suben.
/PRUEBAS-CODIGOS/

# IA frugal fuente (HIVE_OS) — lo esencial (kernel C + genoma) ya está
# vendorizado en native/crates/iafz-sys/. No versionar la fuente cruda.
/iagrufal-main/

# Claude Code: config local de la máquina (permisos/locks), no del proyecto.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Save-state/dumps que quedan en la RAÍZ cuando una herramienta corre desde el
# repo root en vez de native/ (accidental) — el save real vive en native/.
/inventory.json
/structures.json
/tiles.json
/vessels.json
/maps.json
/society/
/vivarium/
/native/native/

# Screenshots/log de los QA drivers (debug/perf.rs, autodrive.rs) — se
# regeneran en cada corrida, no son fuente.
/ha-shot-*.png
/native/bugreport.jsonl
/native/crates/ha-game/assets/art/manifest.json.bak

# Cache de los scripts de Python (import-pack-masivo importa pack_lexico).
__pycache__/
