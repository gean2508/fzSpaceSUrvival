{
  "name": "hunger-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Survival multiplayer 3D — Colyseus + native Bevy client",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "postinstall": "node scripts/bootstrap-workspaces.mjs",
    "play": "node scripts/play.mjs",
    "ship:android": "node scripts/ship-native-android.mjs",
    "smoke:android": "node scripts/smoke-android.mjs",
    "dev:server": "npm run dev -w @hunger-arena/server",
    "dev:client": "npm run build:shared && npm run dev -w @hunger-arena/client",
    "dev": "concurrently -n server,web -c cyan,green \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm run build -w @hunger-arena/shared",
    "build": "npm run build:shared && npm run build -w @hunger-arena/client && npm run build -w @hunger-arena/server",
    "build:server": "npm run build -w @hunger-arena/server",
    "start:server": "npm run start -w @hunger-arena/server",
    "sync:downloads": "node scripts/sync-landing-downloads.mjs",
    "verify:apk": "node scripts/verify-apk-pipeline.mjs",
    "verify": "node scripts/verify-all.mjs",
    "sync:art": "node scripts/sync-art.mjs",
    "tools": "node scripts/tools-server.mjs",
    "test": "npm test -w @hunger-arena/shared",
    "test:native": "make -C native test",
    "phone:install": "bash scripts/device-ready.sh",
    "test:e2e": "npm run build:shared && node scripts/test-join.mjs && node scripts/test-survival.mjs && node scripts/test-auth.mjs && node scripts/test-persist.mjs",
    "validate:arch": "node scripts/check-boundaries.mjs",
    "generate:icons": "python3 scripts/generate-space-icons.py",
    "dev:native": "make -C native run",
    "dev:pc": "node scripts/dev-pc.mjs",
    "dev:pc:game": "node scripts/dev-pc.mjs --game",
    "build:native": "make -C native release",
    "qa:suite": "node scripts/ha-suite.mjs",
    "instalar:pc": "bash scripts/instalar-en-la-pc.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "packageManager": "npm@10.8.2"
}
