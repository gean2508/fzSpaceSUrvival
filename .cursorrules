{
  "project": "Hunger Arena — Survival Multiplayer",
  "stack": {
    "shared": "packages/shared — deterministic GameSimulation + schema + zod",
    "client_core": "packages/client-core — Transport, ArenaController, InputPayload (motor de cliente)",
    "mobile": "apps/mobile — Expo + R3F native + RNGH multi-touch",
    "desktop": "apps/desktop — Tauri + R3F WebGL + Pointer Lock/WASD",
    "server": "server — Colyseus authoritative + Express + Postgres",
    "web": "client — landing descarga APK"
  },
  "architecture_rules": [
    "Read ENGINE.md and .cursor/rules/engine-api.mdc before any gameplay/net/input change",
    "All simulation logic in packages/shared — never duplicate in apps or server",
    "All netcode/prediction in packages/client-core — never duplicate ArenaController in apps",
    "InputPayload MUST match InputState (minus seq) on mobile AND desktop",
    "Hot objects use useRef + useFrame — never useState for positions",
    "Server is input-only — never accept client positions",
    "Validate every inbound message with zod; keep sim deterministic (vitest)",
    "Platform adapters only: TouchControls (mobile), usePcControls+useDesktopAim (desktop)"
  ],
  "debugging_and_observability": {
    "rule_9_observability": "Log connect/disconnect/sync/security events. Debug overlay: FPS, RTT, tick, reconcile error."
  }
}
