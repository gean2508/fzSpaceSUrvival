#!/usr/bin/env bash
# editor_assets — lanzador del editor de assets (programa de DEV, corre aparte
# del juego). Envuelve `ha-asset-tools` para que no tengas que recordar rutas.
#
#   ./editor_assets                       abre HA STUDIO: TODOS los editores en una
#                                         sola ventana (Assets · Imagen · Mundo ·
#                                         Sonido · Fauna; F1..F5 cambian de espacio)
#   ./editor_assets web                   HA Studio EN EL NAVEGADOR (celu por tailnet,
#                                         http://<ip-tailnet>:8790)
#   ./editor_assets assets                sólo el editor de assets/objetos (ventana aparte)
#   ./editor_assets sonido                sólo el editor de sonido (mini-DAW)
#   ./editor_assets mundo                 sólo el editor de MUNDO (WYSIWYG, overrides)
#   ./editor_assets gym-gui                sólo el visor de ADN (fauna/NPC)
#   ./editor_assets chargen --capas       hornea la gente: 20 aldeanos + jugador, y
#                                         las capas + retratos del creador de personaje
#   ./editor_assets play                  recompila el juego y lo publica (npm run play)
#   ./editor_assets help                  esta ayuda
#
# Lo que escribe cada espacio: ver biblia.md §8. El arte va a
# native/crates/ha-game/assets/art/manifest.json y el sonido a
# native/assets/audio.json; los dos se embeben al compilar.
set -euo pipefail

# Raíz del repo = carpeta de este script; el crate vive en native/.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$ROOT/$(basename "${BASH_SOURCE[0]}")"
NATIVE="$ROOT/native"
cd "$NATIVE"
mkdir -p assets

build() {
  echo "▶ compilando ha-asset-tools (primera vez tarda por egui)…" >&2
  cargo build -q -p ha-asset-tools
}

run() { ./target/debug/ha-asset-tools "$@"; }

cmd="${1:-studio}"
case "$cmd" in
  studio|todo|"")
    build
    echo "▶ abriendo HA Studio — un solo programa, cinco espacios de trabajo:" >&2
    echo "  F1 Assets (objetos + variantes)  F2 Imagen  F3 Mundo  F4 Sonido  F5 Fauna" >&2
    run studio
    ;;

  assets|gui)
    build
    echo "▶ abriendo sólo el editor de assets… (ventana aparte del Studio)" >&2
    run gui
    ;;

  web|celu)
    # HA Studio en el navegador (pantalla virtual + página por tailnet).
    build
    cd "$ROOT"
    exec python3 scripts/studio-web.py
    ;;

  sonido|sound)
    build
    echo "▶ abriendo editor de sonido… (edita native/assets/audio.json;" >&2
    echo "  guardá y recompilá con ./build-y-publicar.sh para oírlo en el juego)" >&2
    run sound
    ;;

  mundo|world|mapa)
    build
    echo "▶ abriendo editor de MUNDO (WYSIWYG)… pintás overrides sobre el mundo" >&2
    echo "  procedural; Guardar escribe native/crates/ha-game/assets/world_edits.json;" >&2
    echo "  recompilá el juego (./build-y-publicar.sh) para verlo aplicado)" >&2
    run mundo
    ;;

  gym-gui|gym_gui|npc-gym)
    build
    echo "▶ abriendo visor de ADN (NPC gym)… lista los .adn de society/vivarium/genomes," >&2
    echo "  corré 'Evaluar' para ver el rastro, 'Mutar'/'Cruzar' para experimentar" >&2
    run gym-gui
    ;;

  chargen|personajes)
    # Hornea la gente desde los packs de LimeZu: los 20 aldeanos + el jugador
    # default, y con `--capas` también las capas sueltas y los retratos que come
    # el creador de personaje y el menú de NPC (ver biblia §8).
    build
    shift
    echo "▶ horneando personajes desde PRUEBAS-CODIGOS/Character_Generator…" >&2
    cd "$ROOT"
    "$NATIVE/target/debug/ha-asset-tools" chargen "$@"
    ;;

  play|build-run)
    # Recompila el juego (con los assets editados embebidos) y lo publica.
    echo "▶ recompilando + publicando el juego (npm run play)…" >&2
    cd "$ROOT"
    npm run play
    ;;

  help|-h|--help)
    sed -n '2,17p' "$SELF" | sed 's/^# \{0,1\}//'
    ;;

  *)
    echo "comando desconocido: $cmd (probá: ./editor_assets help)" >&2
    exit 2
    ;;
esac
